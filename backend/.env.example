DATABASE_URL=postgresql+psycopg2://af_user:af_password@localhost:5432/sistema_af
ENVIRONMENT=development

# Conexion de runtime del backend: corre como app_user (no owner), asi RLS
# realmente lo restringe. Crear el rol primero con:
#   python -m scripts.setup_app_role --password "algo-fuerte-aqui"
APP_DATABASE_URL=postgresql+psycopg2://app_user:algo-fuerte-aqui@localhost:5432/sistema_af

# Generar uno propio por entorno, nunca reusar este valor: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-real-secret-per-environment
